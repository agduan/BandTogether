{
  "name": "air-band",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ML/AR air-instrument karaoke band for the browser (HackMIT 2026)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor": "bash scripts/vendor-assets.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "mitt": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tone": "^15.1.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
